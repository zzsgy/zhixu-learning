{
  "manifest_version": 3,
  "name": "知序快速收藏",
  "version": "0.2.1",
  "description": "把当前网页或选中文字保存到本机知序知识库。",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "保存到知序",
    "default_popup": "popup.html"
  }
}
